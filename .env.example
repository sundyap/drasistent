# Copiati in .env (sau completati in Arcane) si puneti valorile reale. NU puneti .env in Git.

# Imaginea aplicatiei, ex. ghcr.io/<utilizator-github>/drasistent:latest
IMAGE=ghcr.io/sundyap/drasistent:latest

# Conexiunea la SQL Server. Exemple pentru Server=:
#   host.docker.internal,1433  - SQLSERVER1 pe acelasi host, cu portul 1433 publicat
#   192.168.1.50,1433          - IP-ul serverului
DB_CONNECTION=Server=host.docker.internal,1433;Database=DrAsistent;User Id=drasistent_app;Password=schimba-ma;TrustServerCertificate=True;Encrypt=True

# Primul cont din aplicatie (creat doar daca nu exista niciun utilizator)
ADMIN_USER=admin
ADMIN_PASSWORD=Schimba-ma123
DEPARTMENT_NAME=Spitalul X - Sectia Y
APP_PORT=8080
